{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cos-design/shared": ["packages/shared/src/index.ts"],
      "@cos-design/shared/react": ["packages/shared/src/react/index.ts"]
    }
  },
  "include": ["src", "packages/shared/src", "packages/*/src", "src/vite-env.d.ts"],
  "exclude": ["src/main.tsx", "src/pages"]
}
