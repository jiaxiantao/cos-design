{
  "name": "cos-design-monorepo",
  "version": "3.8.1",
  "private": true,
  "description": "cos-design monorepo — React visual effect components",
  "type": "module",
  "keywords": [
    "cos",
    "cos-design",
    "react",
    "component-library",
    "visual-effects",
    "canvas",
    "animation",
    "fireworks",
    "confetti",
    "scratch-card",
    "lottery",
    "turntable",
    "matrix-rain",
    "weather-background",
    "neon-text",
    "marketing-page",
    "landing-page",
    "campaign",
    "typescript",
    "vite"
  ],
  "homepage": "https://jiaxiantao.github.io/cos-design/",
  "bugs": {
    "url": "https://github.com/jiaxiantao/cos-design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaxiantao/cos-design.git"
  },
  "author": "jiaxiantao <jiaxiantao@souche.com>",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/install.mjs",
    "preinstall": "npx only-allow pnpm",
    "sync:packages": "node scripts/sync-packages.mjs",
    "migrate:component": "node scripts/migrate-component.mjs",
    "migrate:batch-a": "node scripts/migrate-batch-a.mjs",
    "migrate:batch-b": "node scripts/migrate-batch-b.mjs",
    "verify:v4-matrix": "node scripts/verify-v4-matrix.mjs",
    "sync:logo": "node scripts/sync-public-logo.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "release": "node scripts/release-changed.mjs",
    "predev": "pnpm sync:logo",
    "dev": "vite",
    "build": "node scripts/build-packages.mjs",
    "build:lib": "tsc -p tsconfig.build.json --noEmit && vite build --mode lib",
    "prebuild:demo": "pnpm sync:logo",
    "build:demo": "vite build",
    "prebuild:pages": "pnpm sync:logo",
    "build:pages": "vite build --mode pages",
    "extract-props": "node scripts/extract-component-props.mjs && node scripts/generate-ai-docs.mjs",
    "generate:ai-docs": "node scripts/generate-ai-docs.mjs",
    "verify:context7": "node scripts/verify-context7.mjs",
    "context7:refresh": "node scripts/context7-refresh.mjs",
    "test:smoke": "playwright test",
    "preview": "vite preview",
    "pub": "pnpm build && pnpm --filter \"./packages/**\" publish --access public --no-git-checks",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\" && stylelint \"src/**/*.less\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\" && stylelint \"src/**/*.less\"",
    "lint:js": "eslint \"src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\"",
    "lint:style": "stylelint \"src/**/*.less\"",
    "format": "prettier -c --write \"**/*.{ts,tsx,less,md,json}\"",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.less": "stylelint",
    "**/*.{ts,tsx,less,md,json}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint --fix",
    "packages/shared/src/**/*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "less": "^4.6.6",
    "lint-staged": "^16.2.7",
    "only-allow": "^1.2.2",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-live": "^4.1.8",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.28"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "dependencies": {
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.11",
    "three": "^0.185.1"
  }
}
