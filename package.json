{
  "name": "cos-design",
  "version": "3.0.2",
  "description": "A React component library built with Vite",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "keywords": [
    "cos",
    "cos-design",
    "react",
    "component-library",
    "vite",
    "typescript"
  ],
  "homepage": "https://github.com/jiaxiantao/cos-design#readme",
  "bugs": {
    "url": "https://github.com/jiaxiantao/cos-design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaxiantao/cos-design.git"
  },
  "author": "jiaxiantao <jiaxiantao@souche.com>",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/install.mjs",
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build --mode lib",
    "build:demo": "vite build",
    "preview": "vite preview",
    "pub": "pnpm build && pnpm publish",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && stylelint \"src/**/*.less\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" && stylelint \"src/**/*.less\"",
    "lint:js": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:style": "stylelint \"src/**/*.less\"",
    "format": "prettier -c --write \"**/*.{ts,tsx,less,md,json}\"",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "**/*.less": "stylelint",
    "**/*.{ts,tsx,less,md,json}": "prettier --write",
    "**/*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "less": "^4.6.6",
    "lint-staged": "^16.2.7",
    "only-allow": "^1.2.2",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
