{
  "name": "@cos-design/canvas-clock",
  "version": "4.0.0",
  "description": "CanvasClock component from cos-design",
  "type": "module",
  "main": "./dist/react/index.cjs",
  "module": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element/index.d.ts",
        "default": "./dist/element/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "./dist/element/index.js"
  ],
  "keywords": [
    "cos-design",
    "react",
    "vue",
    "canvasClock",
    "CanvasClock"
  ],
  "homepage": "https://jiaxiantao.github.io/cos-design/",
  "bugs": {
    "url": "https://github.com/jiaxiantao/cos-design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaxiantao/cos-design.git",
    "directory": "packages/canvasClock"
  },
  "author": "jiaxiantao <jiaxiantao@souche.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@cos-design/shared": "workspace:*"
  }
}
